# Razorpay credentials used by the horoscope checkout flow.
# Get these from the Razorpay dashboard (test keys while integrating, live keys for production).
# Copy this file to .env.local and fill in the real values - never commit real keys.

# Client-exposed (Vite bundles VITE_-prefixed vars into the frontend JS) - safe to expose, it's a public key ID.
VITE_RAZORPAY_KEY_ID=

# Server-only - read by api/create-order.js and api/verify-payment.js (Vercel serverless functions).
# RAZORPAY_KEY_SECRET must NEVER be prefixed with VITE_ or referenced from frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# "Sign in with Google" web client ID - must be registered in Firebase Console >
# Authentication > Sign-in method > Google > Web SDK configuration. Reference only;
# the frontend uses Firebase's GoogleAuthProvider, not this value directly.
VITE_GOOGLE_CLIENT_ID=

# Server-only - read by api/admin-auth.js.
# Pick a real password and a long random secret (e.g. `openssl rand -hex 32`)
# before deploying. Never prefix these with VITE_.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only - Firebase Admin SDK service account, used by wallet/referral
# endpoints (api/get-wallet-summary.js, api/create-redemption-request.js,
# api/verify-horoscope-payment.js, api/admin-resolve-redemption.js) to read/write
# Firestore and verify ID tokens with elevated trust the client SDK doesn't have.
# Generate via Firebase Console > Project Settings > Service Accounts >
# Generate new private key. FIREBASE_ADMIN_PRIVATE_KEY must keep its \n sequences
# literal (don't convert to real newlines) - the code un-escapes them at runtime.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
